[core]
    editor = nvim                    # or code, nano, emacs, etc.
    autocrlf = input                # true on Windows, input on Mac/Linux
    ignorecase = false
    excludesfile = ~/.gitignore_global
    ; pager = less -FRX
    ; pager = delta 
[receive]
  denyCurrentBranch = warn
[init]
    defaultBranch = main            # Use 'main' instead of 'master' for new repos

[color]
    ui = auto
    branch = auto
    diff = auto
    status = auto

[color "branch"]
    current = yellow reverse
    local = yellow
    remote = green

[color "diff"]
    meta = yellow bold
    frag = magenta bold
    old = red bold
    new = green bold

[color "status"]
    added = green
    changed = yellow
    untracked = red

; [include]
;   path = ~/.gitalias
    
[push]
    default = current               # Push current branch to remote with same name
    autoSetupRemote = true         # Automatically set up remote tracking

[pull]
    rebase = true                   # Rebase instead of merge when pulling
    ff = only                       # Fast-forward only

[fetch]
    prune = true                    # Remove deleted remote branches

[merge]
	tool = nvimdiff
  conflictstyle = zdiff3           # Show original in merge conflicts

[diff]
	tool = nvimdiff
  algorithm = histogram           # Better diff algorithm
  colorMoved = default           # Highlight moved lines

[difftool]
  tool = nvimdiff 

[rebase]
    autoStash = true               # Automatically stash/unstash before/after rebase
    autoSquash = true              # Automatically squash fixup! commits

[rerere]
  enabled = true
  autoupdate = true

[help]
    autocorrect = 1                # Autocorrect typos (with 0.1 sec delay)

[interactive]
  diffFilter = delta --color-only

[credential]
    helper = cache --timeout=3600  # Cache credentials for 1 hour
    # On macOS: helper = osxkeychain
    # On Windows: helper = manager

; [url "git@github.com:"]
    ; insteadOf = https://github.com/  # Use SSH instead of HTTPS for GitHub

[filter "lfs"]
    clean = git-lfs clean -- %f
    smudge = git-lfs smudge -- %f
    process = git-lfs filter-process
    required = true

